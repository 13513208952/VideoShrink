<Window x:Class="VideoShrink.Views.VisibilityEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="编辑显示项 — 打造你自己的设置面板" Height="620" Width="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,12"
                   Text="勾选「隐藏」的项将不在设置页显示，但它们的当前取值仍然照常生效——隐藏只影响界面，不影响行为。关闭自定义模式即可恢复原来的显示方式。"/>

        <Border Grid.Row="1" BorderThickness="1" CornerRadius="4"
                BorderBrush="{DynamicResource MaterialDesignDivider}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsList" Margin="8">
                    <ItemsControl.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Margin="4,12,0,4" Opacity="0.7"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ItemsControl.GroupStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                    <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                    <Run Text="{Binding AdvancedTag, Mode=OneWay}" FontSize="11" Foreground="#888"/>
                                </TextBlock>
                                <CheckBox Grid.Column="1" Content="隐藏" IsChecked="{Binding Hidden}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="全部显示" Width="110" Click="ShowAll_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="取消" Width="110" Margin="12,0,0,0" IsCancel="True" Click="Cancel_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="保存并退出" Width="140" Margin="12,0,0,0" Click="Save_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
