<Window x:Class="VideoShrink.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:VideoShrink.ViewModels"
        Title="VideoShrink — 批量压缩视频，校验通过才替换原文件"
        Height="760" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 目标文件夹 ─────────────────────────────────────────── -->
        <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,12"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" VerticalAlignment="Center"
                         Text="{Binding TargetDir, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="目标文件夹（含 4K 视频）"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <Button Grid.Column="1" Margin="12,0,0,0" Content="浏览…"
                        Command="{Binding BrowseCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>

                <Button Grid.Column="2" Margin="8,0,0,0" Content="扫描"
                        Command="{Binding ScanCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </Grid>
        </materialDesign:Card>

        <!-- ── 统计 ───────────────────────────────────────────────── -->
        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,12"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="所有集总数" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding QueueTotal}" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="已转换" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Completed}" Style="{StaticResource StatValue}"
                               Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="剩余未转换" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Remaining}" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="失败" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Failed}" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="已节省空间" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding SavedText}" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="5">
                    <TextBlock Text="预计剩余时间" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding EtaText}" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- ── 进度 + 控制 ────────────────────────────────────────── -->
        <materialDesign:Card Grid.Row="2" Padding="16" Margin="0,0,0,12"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <Grid>
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="正在处理："/>
                        <Run Text="{Binding CurrentFile, Mode=OneWay, TargetNullValue='—'}"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right" Opacity="0.7"
                               Text="{Binding Status}"/>
                </Grid>

                <TextBlock Margin="0,10,0,2" Style="{StaticResource StatLabel}" Text="当前文件进度"/>
                <ProgressBar Height="8" Minimum="0" Maximum="100"
                             Value="{Binding CurrentPercent, Mode=OneWay}"/>

                <TextBlock Margin="0,10,0,2" Style="{StaticResource StatLabel}" Text="总体进度"/>
                <ProgressBar Height="8" Minimum="0" Maximum="100"
                             Value="{Binding OverallPercent, Mode=OneWay}"
                             Foreground="{DynamicResource SecondaryHueMidBrush}"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="开始" Width="110" Command="{Binding StartCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                    <Button Content="暂停" Width="110" Margin="10,0,0,0" Command="{Binding PauseCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    <Button Content="继续" Width="110" Margin="10,0,0,0" Command="{Binding ResumeCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    <Button Content="停止" Width="110" Margin="10,0,0,0" Command="{Binding StopCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>

                    <Border Width="1" Margin="20,4" Background="{DynamicResource MaterialDesignDivider}"/>

                    <TextBlock VerticalAlignment="Center" Opacity="0.75">
                        <Run Text="历史累计：成功"/>
                        <Run Text="{Binding HistorySuccess, Mode=OneWay}"/>
                        <Run Text="，失败"/>
                        <Run Text="{Binding HistoryFailed, Mode=OneWay}"/>
                        <Run Text="，共省"/>
                        <Run Text="{Binding HistorySaved, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- ── 日志 / 记录 / 设置 ─────────────────────────────────── -->
        <materialDesign:Card Grid.Row="3" materialDesign:ElevationAssist.Elevation="Dp2">
            <TabControl Style="{StaticResource MaterialDesignTabControl}">

                <TabItem Header="日志">
                    <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas, Cascadia Mono"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"/>
                </TabItem>

                <TabItem Header="转换记录">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8">
                            <Button Content="刷新" Command="{Binding RefreshRecordsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            <Button Content="导出 CSV" Margin="8,0,0,0" Command="{Binding ExportCsvCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            <Button Content="打开记录目录" Margin="8,0,0,0" Command="{Binding OpenRecordsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Records}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserSortColumns="True"
                                  Style="{StaticResource MaterialDesignDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="240"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                                <DataGridTextColumn Header="原分辨率" Width="100">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0}x{1}">
                                            <Binding Path="OrigWidth"/>
                                            <Binding Path="OrigHeight"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="原编码" Binding="{Binding OrigCodec}" Width="80"/>
                                <DataGridTextColumn Header="原体积(B)" Binding="{Binding OrigSize, StringFormat=N0}" Width="120"/>
                                <DataGridTextColumn Header="新体积(B)" Binding="{Binding OutSize, StringFormat=N0}" Width="120"/>
                                <DataGridTextColumn Header="比例" Binding="{Binding Ratio, StringFormat=P1}" Width="70"/>
                                <DataGridTextColumn Header="留痕（丢失/重编码）" Binding="{Binding Notes}" Width="220"/>
                                <DataGridTextColumn Header="失败原因" Binding="{Binding FailReason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" MaxWidth="560" HorizontalAlignment="Left">

                            <TextBlock Text="压制目标" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <TextBox Margin="0,6"
                                     Text="{Binding TargetRatioPercent, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="目标体积比例（%，默认 15）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <TextBox Margin="0,6"
                                     Text="{Binding TargetHeight, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="目标高度（默认 1080）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <TextBlock Text="筛选条件" FontWeight="SemiBold" Margin="0,20,0,8"/>

                            <TextBox Margin="0,6"
                                     Text="{Binding MinSizeGb, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="体积阈值（GB，默认 1）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <TextBox Margin="0,6"
                                     Text="{Binding MinSourceHeight, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="源分辨率下限（默认 2160 = 4K）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <CheckBox Margin="0,10,0,0" Content="递归扫描子目录" IsChecked="{Binding Recursive}"/>
                            <CheckBox Margin="0,6,0,0" Content="重试此前失败的文件" IsChecked="{Binding RetryFailed}"/>

                            <TextBlock Text="编码" FontWeight="SemiBold" Margin="0,20,0,8"/>

                            <ComboBox Margin="0,6" ItemsSource="{Binding Encoders}"
                                      SelectedItem="{Binding Encoder}"
                                      materialDesign:HintAssist.Hint="编码器（SvtAv1 压缩率更高；X265 硬件解码最通用）"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                       Text="两套 preset 各自独立、互不影响，下面只有与所选编码器对应的那一项会生效（另一项自动置灰）。列表均按『压缩率高→低、速度慢→快』排序：越靠上压得越狠越慢，越靠下越快但同画质下文件更大。体积已由目标比例钉死，因此 preset 只影响画质与耗时，不改变成品大小。"/>

                            <ComboBox Margin="0,10,0,0" ItemsSource="{Binding Av1Presets}"
                                      SelectedValue="{Binding PresetAv1}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      IsEnabled="{Binding IsAv1}"
                                      materialDesign:HintAssist.Hint="SVT-AV1 preset（0–13，仅 SvtAv1 生效）"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <ComboBox Margin="0,10,0,0" ItemsSource="{Binding X265Presets}"
                                      SelectedValue="{Binding Preset}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      IsEnabled="{Binding IsX265}"
                                      materialDesign:HintAssist.Hint="x265 preset（仅 X265 生效）"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <TextBox Margin="0,6"
                                     Text="{Binding Parallelism, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="并行任务数（1–4，默认 1）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <TextBlock Text="音频与字幕" FontWeight="SemiBold" Margin="0,20,0,8"/>

                            <ComboBox Margin="0,6" ItemsSource="{Binding AudioPolicies}"
                                      SelectedItem="{Binding AudioPolicy}"
                                      materialDesign:HintAssist.Hint="音频策略"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                       Text="Auto：容器装得下就直拷（零损失）；装不下则回落重编码，并在转换记录里明确标注。CopyOnly：绝不重编码音频，容器装不下即判失败，原文件不动。"/>

                            <TextBox Margin="0,10,0,0"
                                     Text="{Binding AudioReencodeBitrateK, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="音频回落重编码码率（kbps，默认 192）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <CheckBox Margin="0,10,0,0" Content="保留字幕流（容器不支持时会明确记账后丢弃）"
                                      IsChecked="{Binding KeepSubtitles}"/>

                            <TextBlock Text="验收" FontWeight="SemiBold" Margin="0,20,0,8"/>

                            <CheckBox Margin="0,0,0,0" Content="验收时做整片解码校验（推荐开启）"
                                      IsChecked="{Binding FullDecodeCheck}"/>

                            <TextBlock Margin="0,20,0,0" TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                       Text="安全说明：成品必须先通过 ffprobe 与原片逐项交叉比对（编码 / 分辨率 / 时长 / 帧率 / 色彩标签 / 音频流 / 字幕流 / 体积），再通过整片解码校验，才会替换原文件。替换采用『先复制到目标卷 → 校验 → 删原片 → 原子改名』，任何一步崩溃都能在下次启动时恢复。文件名与扩展名保持逐字不变。任何一项不过即判失败，原文件原封不动，程序跳到下一个。"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </materialDesign:Card>
    </Grid>
</Window>
