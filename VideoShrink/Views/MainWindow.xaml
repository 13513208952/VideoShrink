<Window x:Class="VideoShrink.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="VideoShrink — 批量压缩视频，校验通过才落地"
        Height="800" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="GroupHead" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 源文件夹 ─────────────────────────────────────────── -->
        <materialDesign:Card Grid.Row="0" Padding="16" Margin="0,0,0,12"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" VerticalAlignment="Center"
                         Text="{Binding TargetDir, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="源文件夹"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                <Button Grid.Column="1" Margin="12,0,0,0" Content="浏览…"
                        Command="{Binding BrowseCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>

                <Button Grid.Column="2" Margin="8,0,0,0" Content="扫描"
                        Command="{Binding ScanCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </Grid>
        </materialDesign:Card>

        <!-- ── 统计 ────────────────────────────────────────────── -->
        <materialDesign:Card Grid.Row="1" Padding="16" Margin="0,0,0,12"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="待转换总数" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding QueueTotal}" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="已完成" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Completed}" Style="{StaticResource StatValue}"
                               Foreground="{DynamicResource SecondaryHueMidBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="剩余" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Remaining}" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="失败" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding Failed}" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="已节省空间" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding SavedText}" Style="{StaticResource StatValue}"/>
                </StackPanel>
                <StackPanel Grid.Column="5">
                    <TextBlock Text="预计剩余时间" Style="{StaticResource StatLabel}"/>
                    <TextBlock Text="{Binding EtaText}" Style="{StaticResource StatValue}"/>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <!-- ── 进度 + 控制 ─────────────────────────────────────── -->
        <materialDesign:Card Grid.Row="2" Padding="16" Margin="0,0,0,12"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <Border Padding="10" Margin="0,0,0,10" CornerRadius="4"
                        Background="#1FE53935" BorderBrush="#E53935" BorderThickness="1"
                        Visibility="{Binding DestructiveWarnVisible}">
                    <TextBlock TextWrapping="Wrap"
                               Text="⚠ 当前为「直接文件保存」模式：成品会直接写入目标路径，同名文件将被覆盖且不作校验。目标为源目录时即就地替换原文件。"/>
                </Border>

                <Grid>
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="正在处理："/>
                        <Run Text="{Binding CurrentFile, Mode=OneWay, TargetNullValue='—'}"/>
                    </TextBlock>
                    <TextBlock HorizontalAlignment="Right" Opacity="0.7" Text="{Binding Status}"/>
                </Grid>

                <TextBlock Margin="0,10,0,2" Style="{StaticResource StatLabel}" Text="当前文件进度"/>
                <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding CurrentPercent, Mode=OneWay}"/>

                <TextBlock Margin="0,10,0,2" Style="{StaticResource StatLabel}" Text="总体进度"/>
                <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding OverallPercent, Mode=OneWay}"
                             Foreground="{DynamicResource SecondaryHueMidBrush}"/>

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Content="开始" Width="110" Command="{Binding StartCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                    <Button Content="暂停" Width="110" Margin="10,0,0,0" Command="{Binding PauseCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    <Button Content="继续" Width="110" Margin="10,0,0,0" Command="{Binding ResumeCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    <Button Content="停止" Width="110" Margin="10,0,0,0" Command="{Binding StopCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>

                    <Border Width="1" Margin="20,4" Background="{DynamicResource MaterialDesignDivider}"/>

                    <TextBlock VerticalAlignment="Center" Opacity="0.75">
                        <Run Text="历史累计：成功"/>
                        <Run Text="{Binding HistorySuccess, Mode=OneWay}"/>
                        <Run Text="，失败"/>
                        <Run Text="{Binding HistoryFailed, Mode=OneWay}"/>
                        <Run Text="，共省"/>
                        <Run Text="{Binding HistorySaved, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- ── 日志 / 记录 / 设置 ──────────────────────────────── -->
        <materialDesign:Card Grid.Row="3" materialDesign:ElevationAssist.Elevation="Dp2">
            <TabControl Style="{StaticResource MaterialDesignTabControl}">

                <TabItem Header="日志">
                    <ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas, Cascadia Mono"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"/>
                </TabItem>

                <TabItem Header="转换记录">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,8">
                            <Button Content="刷新" Command="{Binding RefreshRecordsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            <Button Content="导出 CSV" Margin="8,0,0,0" Command="{Binding ExportCsvCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            <Button Content="打开记录目录" Margin="8,0,0,0" Command="{Binding OpenRecordsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                        </StackPanel>

                        <DataGrid ItemsSource="{Binding Records}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserSortColumns="True"
                                  Style="{StaticResource MaterialDesignDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="文件" Binding="{Binding FileName}" Width="220"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                                <DataGridTextColumn Header="原体积(B)" Binding="{Binding OrigSize, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="新体积(B)" Binding="{Binding OutSize, StringFormat=N0}" Width="110"/>
                                <DataGridTextColumn Header="比例" Binding="{Binding Ratio, StringFormat=P1}" Width="60"/>
                                <DataGridTextColumn Header="成品位置" Binding="{Binding DestPath}" Width="220"/>
                                <DataGridTextColumn Header="留痕（丢失/重编码）" Binding="{Binding Notes}" Width="240"/>
                                <DataGridTextColumn Header="失败原因" Binding="{Binding FailReason}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20" MaxWidth="600" HorizontalAlignment="Left">

                            <!-- 面板形态 -->
                            <Border Padding="12" CornerRadius="4" Background="{DynamicResource MaterialDesignChipBackground}">
                                <StackPanel>
                                    <CheckBox Content="启用高级调整（展开全部高级选项）"
                                              IsChecked="{Binding ShowAdvanced}"
                                              Visibility="{Binding ShowAdvancedToggleVisible}"/>
                                    <CheckBox Margin="0,8,0,0" Content="自定义模式（逐项勾选隐藏，打造自己的面板）"
                                              IsChecked="{Binding CustomMode}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="编辑显示项…" Command="{Binding EditVisibilityCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                        <Button Content="恢复默认设置" Margin="10,0,0,0"
                                                Command="{Binding ResetDefaultsCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}"
                                               Text="隐藏只影响显示，不影响行为。"/>
                                </StackPanel>
                            </Border>

                            <!-- 输出 -->
                            <TextBlock Text="输出" Style="{StaticResource GroupHead}"/>

                            <ComboBox Margin="0,6" ItemsSource="{Binding OutputLocations}" SelectedItem="{Binding OutputLocation}"
                                      Visibility="{Binding Vis[output_location]}" IsEnabled="{Binding Enabled[output_location]}"
                                      materialDesign:HintAssist.Hint="输出位置（SourceDir 源目录 / FixedPath 指定路径 / AskEveryTime 每次询问）"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <ComboBox Margin="0,6" ItemsSource="{Binding SaveModes}" SelectedItem="{Binding SaveMode}"
                                      Visibility="{Binding Vis[save_mode]}" IsEnabled="{Binding Enabled[save_mode]}"
                                      materialDesign:HintAssist.Hint="保存方式（NewFolder 新建文件夹 / DirectOverwrite 直接保存并覆盖同名）"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <TextBlock Style="{StaticResource Hint}"
                                       Text="新建文件夹：原文件不动。直接保存：同名文件会被覆盖。"/>

                            <Grid Margin="0,10,0,0" Visibility="{Binding Vis[fixed_output_path]}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding FixedOutputPath, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Enabled[fixed_output_path]}"
                                         materialDesign:HintAssist.Hint="固定输出路径（仅 FixedPath 生效）"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="浏览…" Command="{Binding BrowseFixedCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            </Grid>

                            <!-- 体积目标 -->
                            <TextBlock Text="体积目标" Style="{StaticResource GroupHead}"/>

                            <ComboBox Margin="0,6" ItemsSource="{Binding SizeTargetModes}" SelectedItem="{Binding SizeTargetMode}"
                                      Visibility="{Binding Vis[size_target_mode]}" IsEnabled="{Binding Enabled[size_target_mode]}"
                                      materialDesign:HintAssist.Hint="目标模式（Ratio 原体积百分比 / AbsoluteBytes 绝对大小）"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <TextBox Margin="0,6" Text="{Binding TargetRatioPercent, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Vis[target_ratio]}" IsEnabled="{Binding Enabled[target_ratio]}"
                                     materialDesign:HintAssist.Hint="目标体积比例（%，仅 Ratio 模式）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <TextBox Margin="0,6" Text="{Binding TargetMegabytes, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Vis[target_bytes]}" IsEnabled="{Binding Enabled[target_bytes]}"
                                     materialDesign:HintAssist.Hint="目标体积（MB，每个文件；仅 AbsoluteBytes 模式）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <!-- 画面 -->
                            <TextBlock Text="画面" Style="{StaticResource GroupHead}"/>

                            <TextBox Margin="0,6" Text="{Binding TargetHeight, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Vis[target_height]}" IsEnabled="{Binding Enabled[target_height]}"
                                     materialDesign:HintAssist.Hint="目标高度"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <ComboBox Margin="0,6" ItemsSource="{Binding ResizeModes}" SelectedItem="{Binding ResizeMode}"
                                      Visibility="{Binding Vis[resize_mode]}" IsEnabled="{Binding Enabled[resize_mode]}"
                                      materialDesign:HintAssist.Hint="缩放方式（Scale 等比 / Stretch 强行拉伸到目标宽高）"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <TextBox Margin="0,6" Text="{Binding TargetWidth, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Vis[target_width]}" IsEnabled="{Binding Enabled[target_width]}"
                                     materialDesign:HintAssist.Hint="目标宽度（仅 Stretch 模式生效）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <!-- 筛选 -->
                            <TextBlock Text="筛选" Style="{StaticResource GroupHead}"/>

                            <TextBox Margin="0,6" Text="{Binding MinSizeMegabytes, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Vis[min_size_bytes]}" IsEnabled="{Binding Enabled[min_size_bytes]}"
                                     materialDesign:HintAssist.Hint="体积起步线（MB，默认 256）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <TextBox Margin="0,6" Text="{Binding MinSourceHeight, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Vis[min_source_height]}" IsEnabled="{Binding Enabled[min_source_height]}"
                                     materialDesign:HintAssist.Hint="源高度下限（0 = 不筛）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <CheckBox Margin="0,10,0,0" Content="启用源宽度下限（与高度同时限制）"
                                      IsChecked="{Binding EnableMinSourceWidth}"
                                      Visibility="{Binding Vis[enable_min_source_width]}"
                                      IsEnabled="{Binding Enabled[enable_min_source_width]}"/>

                            <TextBox Margin="0,6" Text="{Binding MinSourceWidth, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Vis[min_source_width]}" IsEnabled="{Binding Enabled[min_source_width]}"
                                     materialDesign:HintAssist.Hint="源宽度下限"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <CheckBox Margin="0,10,0,0" Content="递归扫描子目录" IsChecked="{Binding Recursive}"
                                      Visibility="{Binding Vis[recursive]}" IsEnabled="{Binding Enabled[recursive]}"/>
                            <TextBlock Style="{StaticResource Hint}" Visibility="{Binding Vis[recursive]}"
                                       Text="递归会把此前新建的输出文件夹一起扫进来；程序会识别并询问。"/>

                            <!-- 编码 -->
                            <TextBlock Text="编码" Style="{StaticResource GroupHead}"/>

                            <ComboBox Margin="0,6" ItemsSource="{Binding Encoders}" SelectedItem="{Binding Encoder}"
                                      Visibility="{Binding Vis[encoder]}" IsEnabled="{Binding Enabled[encoder]}"
                                      materialDesign:HintAssist.Hint="编码器"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <TextBlock Style="{StaticResource Hint}"
                                       Text="H264 常规档（默认 GPU 加速，体积精度较低）；X265 / SvtAv1 为压缩率而生（CPU、慢、体积精确）。"/>

                            <ComboBox Margin="0,10,0,0" ItemsSource="{Binding Av1Presets}"
                                      SelectedValue="{Binding PresetAv1}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      Visibility="{Binding Vis[preset_av1]}"
                                      IsEnabled="{Binding IsAv1}"
                                      materialDesign:HintAssist.Hint="SVT-AV1 preset（0–13，仅 SvtAv1 生效）"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <ComboBox Margin="0,10,0,0" ItemsSource="{Binding X265Presets}"
                                      SelectedValue="{Binding Preset}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      Visibility="{Binding Vis[preset_x265]}"
                                      IsEnabled="{Binding IsX265}"
                                      materialDesign:HintAssist.Hint="x265 preset（仅 X265 生效）"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <ComboBox Margin="0,10,0,0" ItemsSource="{Binding X264Presets}"
                                      SelectedValue="{Binding PresetX264}" SelectedValuePath="Value" DisplayMemberPath="Label"
                                      Visibility="{Binding Vis[preset_x264]}"
                                      IsEnabled="{Binding IsH264}"
                                      materialDesign:HintAssist.Hint="libx264 preset（仅 H264 且实现为 Cpu 时生效）"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <ComboBox Margin="0,10,0,0" ItemsSource="{Binding H264Impls}" SelectedItem="{Binding H264Impl}"
                                      Visibility="{Binding Vis[h264_impl]}" IsEnabled="{Binding Enabled[h264_impl]}"
                                      materialDesign:HintAssist.Hint="H.264 实现（Auto 自动探测；显式指定不可用者会报错而非静默降级）"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <CheckBox Margin="0,10,0,0" Content="GPU 解码卸载（只加速解码，压缩效率零损失）"
                                      IsChecked="{Binding GpuDecode}"
                                      Visibility="{Binding Vis[gpu_decode]}" IsEnabled="{Binding Enabled[gpu_decode]}"/>

                            <!-- 音频与字幕 -->
                            <TextBlock Text="音频与字幕" Style="{StaticResource GroupHead}"/>

                            <ComboBox Margin="0,6" ItemsSource="{Binding AudioPolicies}" SelectedItem="{Binding AudioPolicy}"
                                      Visibility="{Binding Vis[audio_policy]}" IsEnabled="{Binding Enabled[audio_policy]}"
                                      materialDesign:HintAssist.Hint="音频策略"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>

                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Auto：装得下就直拷，装不下的那几轨才重编码。CopyOnly：绝不重编码，装不下即判失败。"/>

                            <TextBox Margin="0,10,0,0" Text="{Binding AudioReencodeBitrateK, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Vis[audio_reencode_bitrate]}" IsEnabled="{Binding Enabled[audio_reencode_bitrate]}"
                                     materialDesign:HintAssist.Hint="音频重编码码率（kbps，默认 192）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <CheckBox Margin="0,10,0,0" Content="保留字幕流（装不下的逐条丢弃并记账）"
                                      IsChecked="{Binding KeepSubtitles}"
                                      Visibility="{Binding Vis[keep_subtitles]}" IsEnabled="{Binding Enabled[keep_subtitles]}"/>

                            <!-- 验收 -->
                            <TextBlock Text="验收" Style="{StaticResource GroupHead}"/>

                            <CheckBox Content="整片解码校验（推荐开启）" IsChecked="{Binding FullDecodeCheck}"
                                      Visibility="{Binding Vis[full_decode_check]}" IsEnabled="{Binding Enabled[full_decode_check]}"/>

                            <TextBox Margin="0,10,0,0" Text="{Binding MaxOutRatioPercent, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Vis[max_out_ratio]}" IsEnabled="{Binding Enabled[max_out_ratio]}"
                                     materialDesign:HintAssist.Hint="体积上界（%，实际取 max(此值, 目标比例×1.35)）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <TextBox Margin="0,6" Text="{Binding MinOutRatioPercent, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Vis[min_out_ratio]}" IsEnabled="{Binding Enabled[min_out_ratio]}"
                                     materialDesign:HintAssist.Hint="体积下界（%，0 = 关闭）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <!-- 流程 -->
                            <TextBlock Text="流程" Style="{StaticResource GroupHead}"/>

                            <TextBox Margin="0,6" Text="{Binding Parallelism, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding Vis[parallelism]}" IsEnabled="{Binding Enabled[parallelism]}"
                                     materialDesign:HintAssist.Hint="并行任务数（1–4）"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <CheckBox Margin="0,10,0,0" Content="重试此前失败的文件" IsChecked="{Binding RetryFailed}"
                                      Visibility="{Binding Vis[retry_failed]}" IsEnabled="{Binding Enabled[retry_failed]}"/>

                            <TextBlock Margin="0,24,0,0" Style="{StaticResource Hint}"
                                       Text="成品须通过 ffprobe 交叉比对与整片解码校验才会落地；任何一项不过即判失败，源文件不动。详见 README。"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </materialDesign:Card>
    </Grid>
</Window>
